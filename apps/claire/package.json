{
  "name": "@personal/claire",
  "version": "1.0.0",
  "private": true,
  "description": "Claire Foody's website built with Next.js and Payload CMS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "copy:production-db": "NODE_OPTIONS=--no-deprecation payload run scripts/copy-production-database.ts",
    "dev": "NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "test": "NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "format": "oxfmt -c ../../.oxfmtrc.json --write .",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --check .",
    "typecheck": "tsc --noEmit",
    "generate": "pnpm generate:types && pnpm generate:importmap",
    "inventory": "NODE_OPTIONS=--no-deprecation payload run scripts/export-portfolio-inventory.ts",
    "verify:public-media": "NODE_OPTIONS=--no-deprecation payload run scripts/verify-public-media.ts",
    "migrate:portfolio-content": "NODE_OPTIONS=--no-deprecation payload run scripts/migrate-portfolio-content.ts ../../openspec/changes/reorganize-claire-portfolio/content/mapping.json",
    "seed:development": "NODE_OPTIONS=--no-deprecation payload run scripts/seed-development-content.ts",
    "verify:portfolio-content": "NODE_OPTIONS=--no-deprecation payload run scripts/verify-portfolio-migration.ts ../../openspec/changes/reorganize-claire-portfolio/content/mapping.json",
    "migrate": "NODE_OPTIONS=--no-deprecation payload migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@libsql/client": "0.14.0",
    "@payloadcms/db-sqlite": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-s3": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "17.4.2",
    "libsql": "0.4.7",
    "next": "16.4.3",
    "payload": "3.92.1",
    "postcss": "^8.5.25",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-medium-image-zoom": "^5.4.9",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "fast-xml-parser": "5.11.2",
    "jsdom": "30.0.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "10.28.1"
  },
  "packageManager": "pnpm@10.28.1"
}
