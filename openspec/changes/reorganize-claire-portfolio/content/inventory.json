      "aboutPractice": {
        "quote": "Her artistic work emerges from a lifelong relationship with movement, where choreography, film, and spatial installation inform one another.",
        "body": {
          "root": {
            "children": [
              {
                "children": [
                  {
                    "detail": 0,
                    "format": 0,
                    "mode": "normal",
                    "style": "",
                    "text": "Claire Foody is a Canadian multidisciplinary artist and professional dancer based in Europe. Trained at L'École Supérieure de Ballet du Québec and shaped through international performance experience with KOMA Ballet, Johan Inger Youth Project, Ballet de Barcelona, and Les Grands Ballets Canadiens, her practice moves between stage performance, visual installation, and film.",
                    "type": "text",
                    "version": 1
                  }
                ],
                "direction": null,
                "format": "",
                "indent": 0,
                "textFormat": 0,
                "textStyle": "",
                "type": "paragraph",
                "version": 1
              },
              {
