{
  "name": "@personal/fredrik",
  "version": "1.0.0",
  "private": true,
  "description": "Fredrik's personal website — Next.js + Payload CMS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS=--no-deprecation next build --webpack",
    "dev": "NODE_OPTIONS=--no-deprecation next dev",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "test": "NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "format": "oxfmt -c ../../.oxfmtrc.json --write .",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --check .",
    "typecheck": "tsc --noEmit",
    "generate": "pnpm generate:types && pnpm generate:importmap",
    "migrate": "NODE_OPTIONS=--no-deprecation payload migrate",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "seed": "NODE_OPTIONS=--no-deprecation payload run src/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.999.0",
    "@marsidev/react-turnstile": "^1.5.4",
    "@payloadcms/db-sqlite": "3.87.0",
    "@payloadcms/next": "3.87.0",
    "@payloadcms/richtext-lexical": "3.87.0",
    "@payloadcms/storage-s3": "3.87.0",
    "@payloadcms/ui": "3.87.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "feed": "^6.0.0",
    "graphql": "^16.13.0",
    "libsql": "0.4.7",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "payload": "3.87.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.1",
    "sharp": "0.35.3",
    "shiki": "4.4.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "shadcn": "^4.16.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "10.28.1"
  },
  "packageManager": "pnpm@10.28.1"
}
