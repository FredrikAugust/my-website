{
  "name": "personal-websites",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @personal/fredrik --filter @personal/claire dev",
    "dev:fredrik": "pnpm --filter @personal/fredrik dev",
    "dev:claire": "pnpm --filter @personal/claire dev",
    "lint": "pnpm --filter @personal/fredrik lint && pnpm --filter @personal/claire lint",
    "format": "pnpm --filter @personal/fredrik format && pnpm --filter @personal/claire format",
    "format:check": "pnpm --filter @personal/fredrik format:check && pnpm --filter @personal/claire format:check",
    "typecheck": "pnpm --filter @personal/fredrik typecheck && pnpm --filter @personal/claire typecheck",
    "test": "pnpm --filter @personal/fredrik test && pnpm --filter @personal/claire test",
    "generate": "pnpm --filter @personal/fredrik generate && pnpm --filter @personal/claire generate",
    "migrate": "pnpm --filter @personal/fredrik migrate && pnpm --filter @personal/claire migrate",
    "build": "pnpm --filter @personal/fredrik build && pnpm --filter @personal/claire build"
  },
  "devDependencies": {
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "payload": "3.92.1"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "10.28.1"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "msw"
    ],
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.6",
      "@hono/node-server@<1.19.17": "1.19.17",
      "@hono/node-server@>=2 <2.1.5": "2.1.5",
      "@modelcontextprotocol/sdk@>=1 <1.32.2": "1.32.2",
      "baseline-browser-mapping@<2.11.34": "2.11.34",
      "body-parser@>=2 <2.4.0": "2.4.0",
      "brace-expansion@>=5 <5.0.12": "5.0.12",
      "browserslist@<4.28.7": "4.29.5",
      "dompurify@<3.4.17": "3.4.17",
      "esbuild@<=0.24.2": "0.25.12",
      "express-rate-limit@>=8.2.0 <8.2.2": "8.2.2",
      "fast-copy@>=3 <3.1.0": "3.1.0",
      "fast-uri@>=3 <3.1.9": "3.1.9",
      "fast-xml-parser@>=5 <5.11.2": "5.11.2",
      "happy-dom@>=17 <21.0.4": "21.0.4",
      "hono@>=4 <4.13.16": "4.13.16",
      "immutable@>=4 <4.3.9": "4.3.9",
      "ip-address@>=10 <10.7.5": "10.7.5",
      "js-yaml@>=4 <4.3.2": "4.3.2",
      "lodash@>=4 <4.18.1": "4.18.1",
      "nanoid@<3.3.18": "3.3.18",
      "path-to-regexp@>=8 <8.4.2": "8.4.2",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4 <4.0.7": "4.0.7",
      "playwright@<1.55.1": "1.55.1",
      "postcss-selector-parser@>=7 <7.1.7": "7.1.7",
      "proxy-addr@<2.0.8": "2.0.8",
      "qs@>=6.11.1 <6.17.1": "6.17.1",
      "source-map-js@<1.2.2": "1.2.2",
      "tinypool@<2.1.2": "2.2.0",
      "undici@>=7 <7.30.1": "7.30.1",
      "undici@>=8 <8.12.3": "8.12.3",
      "vite@>=7 <7.3.7": "7.3.7",
      "ws@>=8 <8.22.1": "8.22.1",
      "yaml@>=1 <1.10.3": "1.10.3",
      "zod@>=4 <4.6.7": "4.6.7"
    }
  }
}
