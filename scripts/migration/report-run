#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIRECTORY=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=lib.sh
source "$SCRIPT_DIRECTORY/lib.sh"

usage() {
  printf 'usage: %s --run-dir DIRECTORY --operator NAME --retention-until YYYY-MM-DD --current-cost-summary TEXT\n' "$(basename "$0")" >&2
}

run_directory=
operator=
retention_until=
current_cost_summary=
report_name=phase-zero-report.md
while (($#)); do
  case "$1" in
    --run-dir) run_directory=${2-}; shift 2 ;;
    --operator) operator=${2-}; shift 2 ;;
    --retention-until) retention_until=${2-}; shift 2 ;;
    --current-cost-summary) current_cost_summary=${2-}; shift 2 ;;
    --report-name) report_name=${2-}; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) usage; die "unknown argument: $1" ;;
  esac
done

[[ -n "$run_directory" && -n "$operator" && -n "$retention_until" && -n "$current_cost_summary" ]] || { usage; exit 2; }
[[ "$retention_until" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "invalid retention date"
[[ "$report_name" =~ ^[a-z0-9][a-z0-9._-]*\.md$ ]] || die "invalid report name"
require_command jq
run_directory=$(assert_run_directory "$run_directory")
report="$run_directory/reports/$report_name"
assert_new_path "$report"

database_count=$(find "$run_directory/databases" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')
object_source_count=$(find "$run_directory/objects" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')
repository_count=$(find "$run_directory/repositories" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')
restore_verification_count=$(find "$run_directory/databases" -name restore-verification.json -type f | wc -l | tr -d ' ')
object_verification_count=$(find "$run_directory/objects" -name verification.json -type f | wc -l | tr -d ' ')
artifact_verification_present=false
[[ -f "$run_directory/reports/artifact-verification.json" ]] && artifact_verification_present=true

cat >"$report" <<EOF
# Phase-Zero Migration Report

- Run: $(jq -r '.runId' "$run_directory/run.json")
- Started: $(jq -r '.startedAt' "$run_directory/run.json")
- Reported: $(date -u +%Y-%m-%dT%H:%M:%SZ)
- Operator: $operator
- Retain sources through: $retention_until
- Primary archive: $run_directory
- Per-file encryption: intentionally omitted
- Independent copy: intentionally omitted

## Scope and verification

- PostgreSQL sources backed up: $database_count
- PostgreSQL restores verified: $restore_verification_count
- Object-storage sources backed up: $object_source_count
- Object-storage backups verified: $object_verification_count
- Git repositories bundled and clone-tested: $repository_count
- Checksummed artifact verification present: $artifact_verification_present

## Tool versions

- git: $(tool_version git)
- pg_dump: $(tool_version pg_dump)
- pg_restore: $(tool_version pg_restore)
- psql: $(tool_version psql)
- aws: $(tool_version aws)

## Current cost baseline

$current_cost_summary

## Gate

This report is evidence only. Live database or object-storage mutation remains
blocked until every discovered source is represented above, every restore and
object verification has passed, rollback commands are reviewed, and the
operator signs the approval below.

Approval: **ACCEPTED BY $operator**

## Rollback command index

- PostgreSQL restore verification: \`scripts/migration/verify-postgres --help\`
- Object verification: \`scripts/migration/verify-s3 --help\`
- Artifact verification: \`scripts/migration/verify-run --help\`
EOF

chmod 600 "$report"
write_checksum "$report"
printf '%s\n' "$report"
