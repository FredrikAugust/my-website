{
  "rules": [
    {
      "allowed": {
        "origins": ["https://fredrikmalmo.com", "http://localhost:3000"],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["*"]
      },
      "exposeHeaders": ["Accept-Ranges", "Content-Length", "Content-Range", "ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
